{
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@icomoon/fontawesome": "^1.0.0",
    "@types/jquery": "^4.0.1",
    "alpinejs": "^3.15.12",
    "animate.css": "^4.1.1",
    "esbuild": "^0.28.0",
    "jquery": "^4.0.0",
    "noty": "^3.2.0-beta-deprecated",
    "typed.js": "^3.0.0",
    "w3s": "^1.1.0"
  },
  "scripts": {
    "dev": "esbuild src/scripts/* --outdir=assets/dist --watch --bundle --sourcemap --loader:.ttf=copy --loader:.eot=copy --loader:.woff=copy --loader:.woff2=copy --loader:.svg=dataurl --loader:.jpg=dataurl",
    "build": "esbuild src/scripts/* --outdir=assets/dist --minify --bundle --sourcemap --loader:.ttf=copy --loader:.eot=copy --loader:.woff=copy --loader:.woff2=copy --loader:.svg=dataurl --loader:.jpg=dataurl",
    "ci": "biome ci ./",
    "format": "biome format ./ --write"
  }
}
