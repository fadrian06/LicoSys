{
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"nib": "^1.2.0",
		"stylus": "^0.64.0"
	},
	"scripts": {
		"stylus": "stylus src/index.styl -o css/bundle.css -w -m -r --include-css",
		"babel": "babel src/modules -d js -w",
		"build": "RD /S /Q js && RD /S /Q css && babel src/modules -d js --minified && stylus src/index.styl -o css/bundle.css -c -r --include-css"
	},
	"dependencies": {
		"noty": "^3.2.0-beta-deprecated"
	}
}
