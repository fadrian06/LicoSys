{
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@fontsource/oswald": "^5.2.6",
    "@fontsource/roboto": "^5.2.6",
    "@icomoon/fontawesome": "^1.0.0",
    "@types/jquery": "^3.5.32",
    "alpinejs": "^3.14.9",
    "animate.css": "^4.1.1",
    "esbuild": "^0.25.8",
    "jquery": "^3.7.1",
    "noty": "^3.1.4",
    "typed.js": "^2.1.0",
    "w3s": "^1.1.0"
  },
  "scripts": {
    "build": "rm -rf assets/js assets/css & esbuild src/modules/* --outdir=assets/js --minify --bundle --sourcemap --loader:.ttf=copy --loader:.eot=copy --loader:.woff=copy --loader:.woff2=copy --loader:.svg=dataurl --loader:.jpg=dataurl",
    "ci": "biome ci ./",
    "format": "biome format ./ --write"
  }
}
