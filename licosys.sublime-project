{
  "folders": [
    {
      "name": "LicoSys",
      "path": ".",
    },
  ],
  "build_systems": [
    {
      "name": "Build Babel",
      "shell_cmd": "npm run babel",
    },
    {
      "name": "Build Stylus",
      "shell_cmd": "npm run stylus",
    },
    {
      "name": "Build Production",
      "shell_cmd": "npm run build",
    }
  ],
  "settings": {
    "LSP": {
      "formatters": {
        "source.json.sublime": "LSP-json",
        "source.json.babel": "LSP-biome",
        "source.json.composer": "LSP-biome",
        "source.json.npm": "LSP-json",
        "source.js": "LSP-biome",
        "source.json.biome": "LSP-biome",
        "source.css": "LSP-css",
      },
      "LSP-intelephense": {
        "settings": {
          "intelephense.format.braces": "k&r",
        },
      },
    },
    "default_line_ending": "unix",
    "tab_size": 2,
    "translate_tabs_to_spaces": true,
    "trim_trailing_white_space_on_save": "not_on_caret",
    "ensure_newline_at_eof_on_save": true,
    "SublimeLinter.linters.phpstan.disable": false,
    "SublimeLinter.linters.php.disable": false,
    "SublimeLinter.linters.rector.disable": false,
    "SublimeLinter.linters.phpcs.disable": true,
    "SublimeLinter.linters.phpmd.disable": true,
    "SublimeLinter.linters.phpcsfixer.disable": true,
    "SublimeLinter.linters.ecs.disable": true,
  },
}
