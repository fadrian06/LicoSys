{
	"autoload": {
		"files": ["app/functions.php"],
		"psr-4": {
			"App\\": "app"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"process-timeout": 0,
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"ext-session": ">=8.3",
		"php-64bit": ">=8.3",
		"symfony/dotenv": "^7.4"
	},
	"require-dev": {
		"carthage-software/mago": "^1.29.0",
		"guzzlehttp/guzzle": "^7.11",
		"phpunit/phpunit": "^12.5",
		"symfony/var-dumper": "^7.4"
	},
	"scripts": {
		"ci": ["phpunit --colors=auto", "mago lint", "mago analyze"],
		"dev": "php -S localhost:80",
		"format": "mago format"
	}
}
