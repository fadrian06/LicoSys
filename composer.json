{
  "require-dev": {
    "symfony/var-dumper": "^7.3",
    "rector/rector": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpmd/phpmd": "^2.15",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "require": {
    "symfony/dotenv": "^7.3",
    "php": "^8.2",
    "ext-mysqli": "*",
    "leafs/session": "^4.0",
    "flightphp/container": "^1.3",
    "leafs/bareui": "^1.2",
    "flightphp/core": "^3.17"
  },
  "scripts": {
    "pre-install-cmd": ["composer check-platform-reqs", "cp -n .env.dist .env"],
    "ci": [
      "phpcs",
      "phpmd backend templates views dashboard.php index.php rector.php salir.php ansi phpmd.xml",
      "rector --dry-run --no-progress-bar",
      "phpstan --no-progress"
    ],
    "format": ["phpcbf", "rector --no-progress-bar"],
    "baseline": [
      "phpstan --generate-baseline",
      "phpmd backend templates views dashboard.php ecs.php index.php rector.php salir.php ansi phpmd.xml --generate-baseline"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "LicoSys\\": "src"
    },
    "files": ["bootstrap.php"]
  }
}
