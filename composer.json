{
  "autoload": {
    "files": ["app/functions.php"],
    "psr-4": {
      "App\\": "app"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "process-timeout": 0,
    "sort-packages": true
  },
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php-64bit": ">=8.4",
    "ext-pdo_mysql": "*",
    "ext-mysqli": "*",
    "guzzlehttp/psr7": "^2.13",
    "illuminate/container": "^13.35",
    "illuminate/database": "^13.35",
    "leafs/bareui": "^5.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "symfony/dotenv": "^8.1",
    "symfony/polyfill-php85": "^1.43"
  },
  "require-dev": {
    "carthage-software/mago": "^1.56",
    "guzzlehttp/guzzle": "^7.15",
    "phpunit/phpunit": "^13.4",
    "symfony/var-dumper": "^8.1"
  },
  "scripts": {
    "analyze": "mago analyze --no-stubs --sort -m note",
    "analyze:watch": "@analyze --watch",
    "ci": [
      "phpunit -d memory_limit=512M --colors=auto --no-progress --with-telemetry --coverage-text --coverage-html tests/coverage --coverage-xml tests/coverage --show-uncovered-for-coverage-text --path-coverage",
      "php tests/check-coverage.php",
      "@analyze",
      "@lint",
      "@format -c"
    ],
    "dev": "php -S localhost:80",
    "fix": [
      "@lint --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining",
      "@analyze --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining",
      "@guard --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining"
    ],
    "format": "mago format",
    "guard": "mago guard --no-stubs --sort -m note",
    "lint": "mago lint --sort -m note",
    "setup": [
      "composer i",
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "npm i",
      "npm run build"
    ]
  },
  "type": "project"
}
