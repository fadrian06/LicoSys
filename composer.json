{
	"autoload": {
		"files": ["app/functions.php"],
		"psr-4": {
			"App\\": "app"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"process-timeout": 0,
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"ext-session": ">=8.3",
		"php-64bit": ">=8.3",
		"symfony/dotenv": "^7.4"
	},
	"require-dev": {
		"carthage-software/mago": "^1.29.0",
		"guzzlehttp/guzzle": "^7.11",
		"phpunit/phpunit": "^12.5",
		"symfony/var-dumper": "^7.4"
	},
	"scripts": {
		"analyze": "mago analyze --no-stubs --sort -m note --minimum-report-level note",
		"analyze:watch": "composer analyze -- --watch",
		"ci": [
			"phpunit -d memory_limit=512M --colors=auto --no-progress --with-telemetry --coverage-text --show-uncovered-for-coverage-text --path-coverage | php tests/check-coverage.php",
			"composer lint",
			"composer analyze",
			"mago format -c"
		],
		"dev": "php -S localhost:80",
		"format": [
			"composer lint -- --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining",
			"composer analyze -- --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining",
			"composer guard -- --fix --unsafe --potentially-unsafe --format-after-fix --fail-on-remaining",
			"mago format"
		],
		"guard": "mago guard --no-stubs --sort -m note --minimum-report-level note",
		"lint": "mago lint --sort -m note --minimum-report-level note",
		"setup": [
			"composer i",
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
			"npm i --ignore-scripts",
			"npm run build"
		]
	}
}
