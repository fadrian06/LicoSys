{
  "require-dev": {
    "symfony/var-dumper": "^7.2",
    "rector/rector": "^2.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpmd/phpmd": "^2.15",
    "squizlabs/php_codesniffer": "^3.12"
  },
  "require": {
    "symfony/dotenv": "^7.2",
    "php": "^8.2",
    "ext-mysqli": "*"
  },
  "scripts": {
    "pre-install-cmd": ["composer check-platform-reqs", "cp -n .env.dist .env"],
    "ci": [
      "phpcs",
      "phpmd backend templates views dashboard.php index.php rector.php salir.php ansi phpmd.xml",
      "rector --dry-run --no-progress-bar",
      "phpstan --no-progress"
    ],
    "format": ["phpcbf", "rector --no-progress-bar"],
    "baseline": [
      "phpstan --generate-baseline",
      "phpmd backend templates views dashboard.php ecs.php index.php rector.php salir.php ansi phpmd.xml --generate-baseline"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
